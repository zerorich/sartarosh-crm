generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  BARBER
  OWNER
  ADMIN
  SUPER_ADMIN
}

enum SalonStatus {
  PENDING
  ACTIVE
  REJECTED
  BLOCKED
}

enum StaffStatus {
  INVITED
  ACTIVE
  REJECTED
  REMOVED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  CASH
  CARD
}

enum PaymentType {
  DEPOSIT
  REMAINING
  FULL
}

enum DepositType {
  PERCENTAGE
  FIXED
  NONE
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum CouponReason {
  BARBER_LATE
  ADMIN
  PROMOTION
}

enum ExpenseCategory {
  EQUIPMENT
  CONSUMABLE
  RENT
  UTILITY
  MARKETING
  SALARY
  OTHER
}

enum SalaryType {
  FIXED
  PERCENTAGE
  FIXED_PLUS_PERCENTAGE
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  PAYMENT_SUCCESS
  BOOKING_REMINDER
  BOOKING_CANCELLED
  BARBER_STARTED
  BARBER_DELAYED
  COUPON_RECEIVED
  REVIEW_AVAILABLE
  NO_SHOW_WARNING
  BOOKING_RESTRICTION
}

enum AuditAction {
  PRICE_CHANGED
  SALON_APPROVED
  SALON_REJECTED
  SALON_BLOCKED
  USER_BLOCKED
  USER_UNBLOCKED
  PAYMENT_REFUNDED
  PAYMENT_VERIFIED
  REVIEW_CREATED
  REVIEW_UPDATED
  REVIEW_REMOVED
  REVIEW_RESTORED
  BOOKING_CANCELLED
  BOOKING_STARTED
  BOOKING_COMPLETED
  NO_SHOW
  COUPON_CREATED
  COUPON_EXPIRED
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  SALARY_CALCULATED
  COMPLAINT_CREATED
  COMPLAINT_UPDATED
  SETTINGS_UPDATED
  DAILY_REPORT_GENERATED
  FINANCE_AGGREGATED
}

model User {
  id              String    @id @default(uuid())
  phone           String    @unique
  role            Role      @default(CLIENT)
  firstName       String?
  lastName        String?
  avatarUrl       String?
  isBlocked       Boolean   @default(false)
  blockedAt       DateTime?
  blockReason     String?
  noShowCount     Int       @default(0)
  restrictedUntil DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  clientProfile ClientProfile?
  barberProfile BarberProfile?
  ownerProfile  OwnerProfile?

  refreshTokens RefreshToken[]
  clientBookings Booking[]      @relation("ClientBookings")
  reviews        Review[]
  coupons        Coupon[]
  notifications  Notification[]
  complaints     Complaint[]    @relation("ClientComplaints")
  handledComplaints Complaint[] @relation("AdminComplaints")
  auditLogs      AuditLog[]
  salaries       Salary[]

  @@index([phone])
  @@index([role])
}

model ClientProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BarberProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio         String?
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staffAssignments SalonStaff[]
  barberServices   BarberService[]
  workingHours     WorkingHour[]
  blockedTimes     BlockedTime[]
  bookings         Booking[]
  reviews          Review[]
  expenses         Expense[]
}

model OwnerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salons Salon[]
}

model Salon {
  id            String      @id @default(uuid())
  ownerId       String
  owner         OwnerProfile @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name          String
  description   String?
  address       String
  city          String?
  lat           Float
  lng           Float
  phone         String?
  coverUrl      String?
  status        SalonStatus @default(PENDING)
  rejectReason  String?
  rating        Float       @default(0)
  reviewCount   Int         @default(0)
  depositType   DepositType @default(PERCENTAGE)
  depositValue  Decimal     @default(25) @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  staff          SalonStaff[]
  workingHours   WorkingHour[]
  blockedTimes   BlockedTime[]
  services       Service[]
  bookings       Booking[]
  reviews        Review[]
  coupons        Coupon[]
  expenses       Expense[]
  salaries       Salary[]
  complaints     Complaint[]

  @@index([ownerId])
  @@index([status])
  @@index([lat, lng])
}

model SalonStaff {
  id             String     @id @default(uuid())
  salonId        String
  salon          Salon      @relation(fields: [salonId], references: [id], onDelete: Cascade)
  barberId       String
  barber         BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)
  status         StaffStatus @default(INVITED)
  salaryType     SalaryType @default(PERCENTAGE)
  salaryFixed    Decimal    @default(0) @db.Decimal(12, 2)
  salaryPercent  Decimal    @default(50) @db.Decimal(5, 2)
  invitedAt      DateTime   @default(now())
  acceptedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([salonId, barberId])
  @@index([salonId])
  @@index([barberId])
}

model WorkingHour {
  id        String         @id @default(uuid())
  salonId   String?
  salon     Salon?         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  barberId  String?
  barber    BarberProfile? @relation(fields: [barberId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([salonId])
  @@index([barberId])
}

model BlockedTime {
  id        String         @id @default(uuid())
  salonId   String?
  salon     Salon?         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  barberId  String?
  barber    BarberProfile? @relation(fields: [barberId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime       @default(now())

  @@index([salonId, startAt])
  @@index([barberId, startAt])
}

model Service {
  id              String   @id @default(uuid())
  salonId         String
  salon           Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  durationMinutes Int
  price           Decimal  @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  priceHistory   ServicePriceHistory[]
  barberServices BarberService[]
  bookings       Booking[]
  reviews        Review[]

  @@index([salonId])
}

model ServicePriceHistory {
  id            String    @id @default(uuid())
  serviceId     String
  service       Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  price         Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  @@index([serviceId, effectiveFrom])
}

model BarberService {
  id        String        @id @default(uuid())
  barberId  String
  barber    BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([barberId, serviceId])
}

model Booking {
  id               String        @id @default(uuid())
  clientId         String
  client           User          @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Restrict)
  salonId          String
  salon            Salon         @relation(fields: [salonId], references: [id], onDelete: Restrict)
  barberId         String
  barber           BarberProfile @relation(fields: [barberId], references: [id], onDelete: Restrict)
  serviceId        String
  service          Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  status           BookingStatus @default(PENDING)
  startAt          DateTime
  endAt            DateTime
  scheduledStartAt DateTime
  actualStartAt    DateTime?
  actualEndAt      DateTime?
  delayMinutes     Int           @default(0)
  price            Decimal       @db.Decimal(12, 2)
  depositAmount    Decimal       @db.Decimal(12, 2)
  remainingAmount  Decimal       @db.Decimal(12, 2)
  couponId         String?
  coupon           Coupon?       @relation(fields: [couponId], references: [id])
  cancelledAt      DateTime?
  cancelReason     String?
  reminder24hSent  Boolean       @default(false)
  reminder30mSent  Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  payments Payment[]
  review   Review?
  lateCoupon Coupon? @relation("LateCouponBooking")

  @@index([clientId])
  @@index([barberId])
  @@index([salonId])
  @@index([startAt])
  @@index([status])
  @@index([barberId, startAt, endAt])
}

model Payment {
  id          String        @id @default(uuid())
  bookingId   String
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  type        PaymentType
  status      PaymentStatus @default(PENDING)
  providerRef String?
  signature   String?
  verifiedAt  DateTime?
  refundedAt  DateTime?
  refundReason String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([bookingId])
  @@index([status])
}

model Review {
  id            String        @id @default(uuid())
  bookingId     String        @unique
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  clientId      String
  client        User          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  salonId       String
  salon         Salon         @relation(fields: [salonId], references: [id], onDelete: Restrict)
  barberId      String
  barber        BarberProfile @relation(fields: [barberId], references: [id], onDelete: Restrict)
  serviceId     String
  service       Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  barberRating  Int
  salonRating   Int
  serviceRating Int
  comment       String?
  isHidden      Boolean       @default(false)
  hiddenAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([salonId])
  @@index([barberId])
}

model Coupon {
  id          String       @id @default(uuid())
  clientId    String
  client      User         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  salonId     String
  salon       Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  bookingId   String?      @unique
  sourceBooking Booking?   @relation("LateCouponBooking", fields: [bookingId], references: [id])
  reason      CouponReason
  type        CouponType
  value       Decimal      @db.Decimal(10, 2)
  expiresAt   DateTime
  usedAt      DateTime?
  usedBooking Booking[]
  createdAt   DateTime     @default(now())

  @@index([clientId])
  @@index([salonId])
}

model Expense {
  id          String          @id @default(uuid())
  salonId     String
  salon       Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  barberId    String?
  barber      BarberProfile?  @relation(fields: [barberId], references: [id], onDelete: SetNull)
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime
  note        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([salonId])
  @@index([barberId])
  @@index([date])
}

model Salary {
  id          String   @id @default(uuid())
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  barberUserId String
  barberUser  User     @relation(fields: [barberUserId], references: [id], onDelete: Restrict)
  periodStart DateTime
  periodEnd   DateTime
  type        SalaryType
  fixedAmount Decimal  @default(0) @db.Decimal(12, 2)
  percentAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal  @db.Decimal(12, 2)
  servicesTotal Decimal @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  @@index([salonId])
  @@index([barberUserId])
  @@index([periodStart, periodEnd])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}

model Complaint {
  id          String          @id @default(uuid())
  clientId    String
  client      User            @relation("ClientComplaints", fields: [clientId], references: [id], onDelete: Restrict)
  salonId     String?
  salon       Salon?          @relation(fields: [salonId], references: [id], onDelete: SetNull)
  bookingId   String?
  subject     String
  body        String
  status      ComplaintStatus @default(OPEN)
  adminNote   String?
  handledById String?
  handledBy   User?           @relation("AdminComplaints", fields: [handledById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
  @@index([clientId])
}

model AdminSetting {
  id                             String   @id @default(uuid())
  noShowLimit                    Int      @default(3)
  noShowRestrictionDays          Int      @default(14)
  barberDelayThreshold           Int      @default(5)
  barberDelayCompensationPercent Decimal  @default(10) @db.Decimal(5, 2)
  couponExpirationDays           Int      @default(30)
  reviewEditWindow               Int      @default(48)
  defaultSearchRadius            Int      @default(10)
  reminder24hEnabled             Boolean  @default(true)
  reminder30mEnabled             Boolean  @default(true)
  updatedAt                      DateTime @updatedAt
}

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
