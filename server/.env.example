NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Local dev: use localhost Postgres. On Railway, set DATABASE_URL in project Variables (internal host postgres.railway.internal), not in this file.
DATABASE_URL=postgresql://sartarosh:sartarosh@localhost:5432/sartarosh
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
OTP_SECRET=change-me-otp-secret-min-32-chars
PAYMENT_SECRET=change-me-payment-secret-min-32-chars

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

STORAGE_URL=
STORAGE_KEY=
STORAGE_SECRET=

# Gmail SMTP for local OTP emails (https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_FROM=

# Gmail via Apps Script webhook (Railway Hobby: send as your Gmail to any address, no custom domain)
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=
